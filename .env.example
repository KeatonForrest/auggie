# Auggie Configuration
# Copy this file to .env and fill in your values

# Firecrawl API - for web scraping
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Anthropic - for Claude AI (optional, no longer used for research/writing)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenRouter - for research and writing LLM calls
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional model overrides (defaults shown)
# RESEARCH_MODEL=google/gemini-2.5-flash
# WRITING_MODEL=mistralai/mistral-small-creative

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:port/database

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ===========================================
# v2 Materials Feature (Optional)
# ===========================================

# Enable materials feature
MATERIALS_ENABLED=false

# OpenAI - for embeddings
OPENAI_API_KEY=your_openai_api_key

# Cloudflare R2 - for file storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=auggie-materials
