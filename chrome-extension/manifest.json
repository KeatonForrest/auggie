{
  "manifest_version": 3,
  "name": "Auggie — Company Research",
  "version": "1.0.1",
  "description": "Instantly research any company from the website you're browsing. Get pain/fit/timing scores and talking points.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["https://auggie.tools/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
